@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

' Тема
!theme plain
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 30

title C4 Model — Telegram Currency Bot (Container Diagram)

' ============================================
' 2. КОНТЕЙНЕРНАЯ ДИАГРАММА
' ============================================

Person(user, "Пользователь", "Отправляет запросы")

System_Boundary(botSystem, "Currency Bot System") {

    Container(server, "Fastify Server", "Node.js 20+, Fastify", "Обрабатывает вебхуки и логику бота")
    Container(webhook, "Webhook Handler", "Fastify", "POST /webhook/telegram\nЛогирует апдейты")
    Container(currencyBot, "Currency Bot", "Node.js", "Обрабатывает команды и запросы курсов")
    Container(logger, "Logger", "Console", "Логирует все апдейты")

    ContainerDb(config, "Config", ".env", "Хранит BOT_TOKEN, TUNNEL_URL")
    Container(setup, "Setup Script", "Node.js", "set-webhook.js\nУстанавливает вебхук автоматически")
}

System_Ext(telegramApi, "Telegram API", "https://api.telegram.org")
System_Ext(nbrbApi, "НБРБ API", "https://api.nbrb.by")
System_Ext(binanceApi, "Binance API", "https://api.binance.com")
System_Ext(tunnel, "Туннель", "localhost.run", "https://*.lhr.life")

' Связи
Rel(user, telegramApi, "Сообщение", "HTTPS")
Rel(telegramApi, tunnel, "POST /webhook", "HTTPS")
Rel(tunnel, server, "Forward", "HTTP")
Rel(server, webhook, "Маршрутизация")
Rel(webhook, currencyBot, "Передача данных")
Rel(webhook, logger, "Логирование")
Rel(currencyBot, nbrbApi, "GET /rates", "HTTPS")
Rel(currencyBot, binanceApi, "GET /ticker", "HTTPS")
Rel(currencyBot, telegramApi, "sendMessage", "HTTPS")

Rel(setup, config, "Читает/Записывает\nTUNNEL_URL")
Rel(setup, telegramApi, "setWebhook", "HTTPS")
Rel(server, config, "Читает\nBOT_TOKEN, PORT")

LAYOUT_TOP_DOWN()
@enduml