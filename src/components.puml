@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

' Тема
!theme plain
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 30

title C4 Model — Telegram Currency Bot (Component Diagram)

' ============================================
' 3. КОМПОНЕНТНАЯ ДИАГРАММА
' ============================================

Container(server, "Fastify Server", "Node.js", "Сервер с вебхуком")

System_Boundary(components, "Компоненты Currency Bot") {

    Component(webhookHandler, "Webhook Handler", "Fastify", "POST /webhook/telegram")
    Component(parser, "Update Parser", "JavaScript", "Парсит входящий апдейт")
    Component(validator, "Message Validator", "JavaScript", "Проверяет наличие текста")

    Component(currencyMapper, "Currency Mapper", "JavaScript", "Маппинг USD→доллар\nUSDT→тетер")
    Component(rateFetcher, "Rate Fetcher", "JavaScript", "Получает курс из API")
    Component(responseBuilder, "Response Builder", "JavaScript", "Форматирует ответ")

    Component(commandHandler, "Command Handler", "JavaScript", "/start, /help, /rates")

    Component(sendMessage, "Send Message", "JavaScript", "Отправка в Telegram")
    Component(logger, "Logger", "Console", "Логирование")
}

System_Ext(nbrbApi, "НБРБ API", "https://api.nbrb.by")
System_Ext(binanceApi, "Binance API", "https://api.binance.com")
System_Ext(telegramApi, "Telegram API", "https://api.telegram.org")

' Внутренние связи
Rel(webhookHandler, parser, "Передает")
Rel(parser, validator, "Проверяет")
Rel(validator, commandHandler, "Маршрутизирует")
Rel(validator, currencyMapper, "Определяет валюту")

Rel(currencyMapper, rateFetcher, "Запрашивает курс")
Rel(rateFetcher, nbrbApi, "GET /rates", "HTTPS")
Rel(rateFetcher, binanceApi, "GET /ticker", "HTTPS")

Rel(rateFetcher, responseBuilder, "Возвращает курс")
Rel(commandHandler, responseBuilder, "Возвращает ответ")
Rel(responseBuilder, sendMessage, "Отправляет ответ")

Rel(webhookHandler, logger, "Логирует")
Rel(sendMessage, telegramApi, "sendMessage", "HTTPS")

LAYOUT_TOP_DOWN()

@enduml