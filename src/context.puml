@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

' Тема
!theme plain
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 30

' Эпиграф
title C4 Model — Telegram Currency Bot (Context Diagram)

' ============================================
' 1. КОНТЕКСТНАЯ ДИАГРАММА (System Context)
' ============================================

' Пользователь
Person(user, "Пользователь", "Отправляет запросы на курс валют")

' Система (твой бот)
System_Boundary(botSystem, "Currency Bot System") {
    System(telegramBot, "Telegram Bot", "Принимает команды и возвращает курсы валют в BYN")
}

' Внешние системы
System_Ext(telegramApi, "Telegram API", "https://api.telegram.org", "Принимает вебхуки и отправляет сообщения")
System_Ext(nbrbApi, "НБРБ API", "https://api.nbrb.by", "Курсы фиатных валют к BYN")
System_Ext(binanceApi, "Binance API", "https://api.binance.com", "Курс USDT к USD")
System_Ext(tunnel, "Туннель", "localhost.run", "Пробрасывает порт наружу")

' Связи
Rel(user, telegramApi, "Отправляет сообщение", "HTTPS")
Rel(telegramApi, tunnel, "POST /webhook", "HTTPS")
Rel(tunnel, telegramBot, "Forward запроса", "HTTP")
Rel(telegramBot, nbrbApi, "GET /rates/{currency}", "HTTPS")
Rel(telegramBot, binanceApi, "GET /ticker/price", "HTTPS")
Rel(telegramBot, telegramApi, "sendMessage", "HTTPS")

' Легенда
LAYOUT_TOP_DOWN()
@enduml